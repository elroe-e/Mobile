<?xml version="1.0" encoding="utf-8"?>
<!-- Loss manifest. Used as-is by `dx` (see [application] in Dioxus.toml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions and services come from android/glue/src/main/AndroidManifest.xml (merged by Gradle). -->

    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- singleTask: tapping the notification returns to the running app
             instead of starting a second copy. -->
        <activity android:configChanges="orientation|screenLayout|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
